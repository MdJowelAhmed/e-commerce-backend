# ==============================================================================
# LUXE ENTERPRISE BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
APP_NAME=Luxe Luxury eCommerce API

# Frontend Client URL (for CORS & HttpOnly Cookie domain)
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration (Supports Replica Set for ACID Transactions)
MONGODB_URI=mongodb://localhost:27017/luxe_ecommerce
MONGODB_DB_NAME=luxe_ecommerce

# Redis Configuration (Cache-Manager & BullMQ background queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=luxe_super_secret_jwt_access_key_enterprise_2026_@_sec
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=luxe_super_secret_jwt_refresh_key_enterprise_2026_@_ref
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=luxe_cookie_signing_secret_enterprise_2026
COOKIE_DOMAIN=localhost

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Payment Gateways (Adapters)
# SSLCommerz
SSLCOMMERZ_STORE_ID=luxe_test_store
SSLCOMMERZ_STORE_PASSWD=luxe_test_passwd
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/checkout/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/checkout/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/checkout/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payments/webhook/sslcommerz

# bKash Payment
BKASH_APP_KEY=bkash_mock_app_key
BKASH_APP_SECRET=bkash_mock_app_secret
BKASH_USERNAME=bkash_mock_username
BKASH_PASSWORD=bkash_mock_password
BKASH_IS_SANDBOX=true

# Nagad Payment
NAGAD_MERCHANT_ID=nagad_mock_merchant_id
NAGAD_PUBLIC_KEY=nagad_mock_public_key
NAGAD_PRIVATE_KEY=nagad_mock_private_key

# Google Gemini AI Integration (Concierge, Semantic Search, Outfit Generator)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

